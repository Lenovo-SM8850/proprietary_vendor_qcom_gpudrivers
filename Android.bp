        "$(locations a840/870.0/lib64/*.so) $(location a840/870.0/sphal_libraries.txt)",
}

android_app_import {
    name: "AdrenoA840_870_0",
    apk: ":AdrenoA840_870_0_apk",
    presigned: false,
    certificate: "platform",
    vendor: true,
    dex_preopt: {
        enabled: false,
    },
}

